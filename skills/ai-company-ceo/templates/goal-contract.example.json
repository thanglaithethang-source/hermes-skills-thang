{
  "objective": "Build and verify a local task management web application.",
  "deliverables": [
    "Backend API",
    "Frontend application",
    "Automated tests",
    "Docker Compose",
    "QA report"
  ],
  "acceptance_criteria": [
    {
      "id": "AC-01",
      "condition": "Backend health endpoint returns HTTP 200",
      "verification": "command:Automated integration test",
      "status": "PENDING"
    },
    {
      "id": "AC-02",
      "condition": "Frontend production build succeeds",
      "verification": "command:npm build exit code 0",
      "status": "PENDING"
    }
  ],
  "constraints": {
    "max_parallel_workers": 6,
    "max_repair_cycles": 5,
    "max_retries_per_task": 3,
    "budget_usd": null,
    "deadline_iso": null
  },
  "approval_gates": [
    "merge_main",
    "production_deploy"
  ],
  "prohibited_actions": [
    "external messaging",
    "spending money"
  ],
  "stop_conditions": [
    "all criteria pass",
    "repair limit reached",
    "approval required",
    "unresolvable blocker"
  ]
}
