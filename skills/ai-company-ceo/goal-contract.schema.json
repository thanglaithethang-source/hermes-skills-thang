{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Company Goal Contract",
  "type": "object",
  "required": [
    "objective",
    "deliverables",
    "acceptance_criteria",
    "constraints",
    "approval_gates",
    "stop_conditions"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "condition",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "required": [
        "max_parallel_workers",
        "max_repair_cycles",
        "max_retries_per_task"
      ],
      "properties": {
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_repair_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_retries_per_task": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deadline_iso": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
